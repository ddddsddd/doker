# Сайт nginx для MCP-сервера. setup.sh создаёт из этого шаблона nginx-site.conf с вашим доменом.
# HTTPS добавит certbot: sudo certbot --nginx -d __DOMAIN__
server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN__;

    location / {
        proxy_pass http://127.0.0.1:__PORT__;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # $remote_addr, а не $proxy_add_x_forwarded_for: клиент не должен подставлять свой IP
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        # MCP отвечает потоком (SSE) — без буферизации и с долгим таймаутом
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        client_max_body_size 20m;
    }
}
