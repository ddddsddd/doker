# Обычно этот файл создаёт ./setup.sh. Ручная настройка: cp .env.example .env и заполните.

# Домен, A-запись которого указывает на IP вашего сервера
DOMAIN=mcp.example.com

# Пароль, который вы вводите при подключении коннектора в claude.ai (минимум 12 символов)
ADMIN_PASSWORD=

# Токен для Claude Code и других клиентов с заголовком Authorization (минимум 32 символа).
# Оставьте пустым, если не нужен.
API_TOKEN=

# caddy — встроенный HTTPS (нужны свободные порты 80 и 443).
# caddy,sni — порт 443 общий с VPN (настраивает ./setup.sh).
# Пусто — если HTTPS делает ваш nginx/apache (см. README).
COMPOSE_PROFILES=caddy

# Порт на 127.0.0.1, куда проксирует ваш nginx/apache
MCP_LOCAL_PORT=8000

# Таймаут команды по умолчанию и максимальный, в секундах
# COMMAND_TIMEOUT=120
# MAX_COMMAND_TIMEOUT=1800
