# Домен, A-запись которого указывает на IP вашего сервера
DOMAIN=mcp.example.com

# Пароль, который вы вводите при подключении коннектора в claude.ai (минимум 12 символов)
ADMIN_PASSWORD=

# Токен для Claude Code и других клиентов с заголовком Authorization (минимум 32 символа).
# Оставьте пустым, если не нужен.
API_TOKEN=

# Таймаут команды по умолчанию и максимальный, в секундах
# COMMAND_TIMEOUT=120
# MAX_COMMAND_TIMEOUT=1800
